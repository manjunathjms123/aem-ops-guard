# Local AEM author settings. Copy to local.env and fill in.
# Replace REPLACE_WITH_LOCAL_PASSWORD with the local admin password. This file is git-ignored,
# but the password is stored in plain text, so keep the file private.
# An AEM_LOCAL_PASSWORD environment variable, if set, overrides the value here.
# Other environments (QA, UAT, Cloud) take their passwords from environment variables only.

AEM_LOCAL_URL=http://localhost:4502
AEM_LOCAL_USER=admin
AEM_LOCAL_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# Felix check path. Default: /system/console/bundles.json
# AEM_LOCAL_PING_PATH=/system/console/bundles.json

# Author pages for "sanity", comma-separated. Set them here only; sanity takes no page arguments.
AEM_LOCAL_SITE_PAGE=/sites.html,/assets.html,/content/wknd/us/en.html,/content/wknd/us/en/about-us.html,/content/wknd/us/en/magazine/ski-touring.html,/content/wknd/us/en/adventures/ski-touring-mont-blanc.html

# CRX DE page. "sanity" checks it in addition to the site pages.
AEM_LOCAL_CRX_DE_PAGE=/crx/de/index.jsp

# Package Manager page. "sanity" checks it in addition to the site pages.
AEM_LOCAL_PACK_MGR_PAGE=/crx/packmgr/index.jsp

# OSGi R6 check (optional): bundles that must be Active, and config PIDs that must exist.
AEM_LOCAL_OSGI_REQUIRED_BUNDLES=aem-guides-wknd.core:4.0.4:Active
# AEM_LOCAL_OSGI_CONFIG_PIDS=com.example.core.SomeService
# AEM_LOCAL_OSGI_CONFIG_PATH=/system/console/configMgr

# Permissions check: the user must be running as itself and belong to these groups (optional).
# AEM_LOCAL_EXPECTED_GROUPS=content-authors
AEM_LOCAL_CURRENT_USER_PATH=/libs/granite/security/currentuser.json

# Felix console endpoints, used by "felix". Defaults are shown; uncomment to override.
# AEM_LOCAL_FELIX_CONSOLE_PATH=/system/console
# AEM_LOCAL_PING_PATH=/system/console/bundles.json          (bundle list; used by sanity)
# AEM_LOCAL_OSGI_CONFIG_PATH=/system/console/configMgr      (Configuration Manager)
# AEM_LOCAL_FELIX_COMPONENTS_PATH=/system/console/components
# AEM_LOCAL_FELIX_SERVICES_PATH=/system/console/services
# AEM_LOCAL_FELIX_LOGS_PATH=/system/console/logs
# AEM_LOCAL_FELIX_MEMORY_PATH=/system/console/memory
# AEM_LOCAL_FELIX_THREADS_PATH=/system/console/threads
# AEM_LOCAL_FELIX_SLING_SETTINGS_PATH=/system/console/status-slingsettings
# AEM_LOCAL_FELIX_SLING_JOB_PATH=/system/console/slingjob
# AEM_LOCAL_FELIX_SLING_EVENT_PATH=/system/console/slingevent

# Sling console endpoints, used by "felix". Defaults are shown; uncomment to override.
# AEM_LOCAL_SLING_LOG_PATH=/system/console/slinglog
# AEM_LOCAL_SLING_REQUESTS_PATH=/system/console/requests
# AEM_LOCAL_SLING_JCRRESOLVER_PATH=/system/console/jcrresolver
# AEM_LOCAL_SLING_SERVLETRESOLVER_PATH=/system/console/servletresolver
# AEM_LOCAL_SLING_MODELS_PATH=/system/console/slingmodels
# AEM_LOCAL_SLING_ADAPTERS_PATH=/system/console/adapters
# AEM_LOCAL_SLING_FILTER_PATH=/system/console/slingfilter

# Login check, used by "login". Defaults are shown; uncomment to override.
# The password is tested only through the login form; it is never printed.
AEM_LOCAL_LOGIN_PATH=/libs/granite/core/content/login.html
# AEM_LOCAL_LOGIN_SUBMIT_PATH=/j_security_check
