# AEM as a Cloud Service author settings. Copy to cloud.env and fill in.
# Password: set AEM_CLOUD_PASSWORD as an environment variable (never in this file).

AEM_CLOUD_URL=https://author-pXXXXX-eXXXXX.adobeaemcloud.com
AEM_CLOUD_USER=

# Plain HTTP is refused unless you set this to true. The password then goes unencrypted; use only on a trusted network.
# AEM_CLOUD_ALLOW_HTTP=true

# Felix check path. Cloud may restrict the console, so confirm which path your
# environment allows. Default: /system/console/bundles.json
# AEM_CLOUD_PING_PATH=/system/console/bundles.json

# Author pages for "sanity", comma-separated. Set them here only; sanity takes no page arguments.
AEM_CLOUD_SITE_PAGE=/content/mysite/en.html

# CRX DE page. "sanity" checks it in addition to the site pages. Cloud may block /crx/de.
AEM_CLOUD_CRX_DE_PAGE=/crx/de/index.jsp

# Package Manager page. "sanity" checks it in addition to the site pages. Cloud may block /crx/packmgr.
AEM_CLOUD_PACK_MGR_PAGE=/crx/packmgr/index.jsp

# OSGi R6 check (optional): bundles that must be Active, and config PIDs that must exist.
# AEM_CLOUD_OSGI_REQUIRED_BUNDLES=com.example.core
# AEM_CLOUD_OSGI_CONFIG_PIDS=com.example.core.SomeService
# AEM_CLOUD_OSGI_CONFIG_PATH=/system/console/configMgr

# Permissions check: the user must be running as itself and belong to these groups (optional).
# AEM_CLOUD_EXPECTED_GROUPS=content-authors
AEM_CLOUD_CURRENT_USER_PATH=/libs/granite/security/currentuser.json

# Felix console endpoints, used by "felix". Defaults are shown; uncomment to override.
# Cloud may block some of these paths; "felix" will show which ones answer.
# AEM_CLOUD_FELIX_CONSOLE_PATH=/system/console
# AEM_CLOUD_PING_PATH=/system/console/bundles.json          (bundle list; used by sanity)
# AEM_CLOUD_OSGI_CONFIG_PATH=/system/console/configMgr      (Configuration Manager)
# AEM_CLOUD_FELIX_COMPONENTS_PATH=/system/console/components
# AEM_CLOUD_FELIX_SERVICES_PATH=/system/console/services
# AEM_CLOUD_FELIX_LOGS_PATH=/system/console/logs
# AEM_CLOUD_FELIX_MEMORY_PATH=/system/console/memory
# AEM_CLOUD_FELIX_THREADS_PATH=/system/console/threads
# AEM_CLOUD_FELIX_SLING_SETTINGS_PATH=/system/console/status-slingsettings
# AEM_CLOUD_FELIX_SLING_JOB_PATH=/system/console/slingjob
# AEM_CLOUD_FELIX_SLING_EVENT_PATH=/system/console/slingevent

# Sling console endpoints, used by "felix". Defaults are shown; uncomment to override.
# Cloud may block some of these paths; "felix" will show which ones answer.
# AEM_CLOUD_SLING_LOG_PATH=/system/console/slinglog
# AEM_CLOUD_SLING_REQUESTS_PATH=/system/console/requests
# AEM_CLOUD_SLING_JCRRESOLVER_PATH=/system/console/jcrresolver
# AEM_CLOUD_SLING_SERVLETRESOLVER_PATH=/system/console/servletresolver
# AEM_CLOUD_SLING_MODELS_PATH=/system/console/slingmodels
# AEM_CLOUD_SLING_ADAPTERS_PATH=/system/console/adapters
# AEM_CLOUD_SLING_FILTER_PATH=/system/console/slingfilter

# Login check, used by "login". Defaults are shown; uncomment to override.
# The password is tested only through the login form; it is never printed.
AEM_CLOUD_LOGIN_PATH=/libs/granite/core/content/login.html
# AEM_CLOUD_LOGIN_SUBMIT_PATH=/j_security_check
