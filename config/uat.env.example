# UAT author settings. Copy to uat.env and fill in.
# Password: set AEM_UAT_PASSWORD as an environment variable (never in this file).

AEM_UAT_URL=https://uat-author.example.com
AEM_UAT_USER=

# Plain HTTP is refused unless you set this to true. The password then goes unencrypted; use only on a trusted network.
# AEM_UAT_ALLOW_HTTP=true

# Felix check path. Default: /system/console/bundles.json
# AEM_UAT_PING_PATH=/system/console/bundles.json

# Author pages for "sanity", comma-separated. Set them here only; sanity takes no page arguments.
AEM_UAT_SITE_PAGE=/content/mysite/en.html

# CRX DE page. "sanity" checks it in addition to the site pages.
AEM_UAT_CRX_DE_PAGE=/crx/de/index.jsp

# Package Manager page. "sanity" checks it in addition to the site pages.
AEM_UAT_PACK_MGR_PAGE=/crx/packmgr/index.jsp

# OSGi R6 check (optional): bundles that must be Active, and config PIDs that must exist.
# AEM_UAT_OSGI_REQUIRED_BUNDLES=com.example.core
# AEM_UAT_OSGI_CONFIG_PIDS=com.example.core.SomeService
# AEM_UAT_OSGI_CONFIG_PATH=/system/console/configMgr

# Permissions check: the user must be running as itself and belong to these groups (optional).
# AEM_UAT_EXPECTED_GROUPS=content-authors
AEM_UAT_CURRENT_USER_PATH=/libs/granite/security/currentuser.json

# Felix console endpoints, used by "felix". Defaults are shown; uncomment to override.
# AEM_UAT_FELIX_CONSOLE_PATH=/system/console
# AEM_UAT_PING_PATH=/system/console/bundles.json          (bundle list; used by sanity)
# AEM_UAT_OSGI_CONFIG_PATH=/system/console/configMgr      (Configuration Manager)
# AEM_UAT_FELIX_COMPONENTS_PATH=/system/console/components
# AEM_UAT_FELIX_SERVICES_PATH=/system/console/services
# AEM_UAT_FELIX_LOGS_PATH=/system/console/logs
# AEM_UAT_FELIX_MEMORY_PATH=/system/console/memory
# AEM_UAT_FELIX_THREADS_PATH=/system/console/threads
# AEM_UAT_FELIX_SLING_SETTINGS_PATH=/system/console/status-slingsettings
# AEM_UAT_FELIX_SLING_JOB_PATH=/system/console/slingjob
# AEM_UAT_FELIX_SLING_EVENT_PATH=/system/console/slingevent

# Sling console endpoints, used by "felix". Defaults are shown; uncomment to override.
# AEM_UAT_SLING_LOG_PATH=/system/console/slinglog
# AEM_UAT_SLING_REQUESTS_PATH=/system/console/requests
# AEM_UAT_SLING_JCRRESOLVER_PATH=/system/console/jcrresolver
# AEM_UAT_SLING_SERVLETRESOLVER_PATH=/system/console/servletresolver
# AEM_UAT_SLING_MODELS_PATH=/system/console/slingmodels
# AEM_UAT_SLING_ADAPTERS_PATH=/system/console/adapters
# AEM_UAT_SLING_FILTER_PATH=/system/console/slingfilter

# Login check, used by "login". Defaults are shown; uncomment to override.
# The password is tested only through the login form; it is never printed.
AEM_UAT_LOGIN_PATH=/libs/granite/core/content/login.html
# AEM_UAT_LOGIN_SUBMIT_PATH=/j_security_check
