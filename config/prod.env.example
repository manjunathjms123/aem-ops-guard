# Production author settings, used by "drift" and "sanity --env prod". Copy to prod.env and fill in.
# Password: set AEM_PROD_PASSWORD as an environment variable (never in this file).
# Production reads are typically restricted. Use a read-only user and check each endpoint first.

AEM_PROD_URL=https://author-prod.example.com
AEM_PROD_USER=

# Plain HTTP is refused unless you set this to true. The password then goes unencrypted; use only on a trusted network.
# AEM_PROD_ALLOW_HTTP=true

# Felix bundle list, used by sanity and drift. Default: /system/console/bundles.json
# AEM_PROD_PING_PATH=/system/console/bundles.json

# Configuration Manager, used by sanity and drift. Default: /system/console/configMgr
# AEM_PROD_OSGI_CONFIG_PATH=/system/console/configMgr

# Query builder path for the user and group counts, used by drift and sanity.
# Default: /bin/querybuilder.json
# AEM_PROD_USER_QUERY_PATH=/bin/querybuilder.json
AEM_PROD_CURRENT_USER_PATH=/libs/granite/security/currentuser.json
